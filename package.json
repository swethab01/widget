{
  "name": "devpulse",
  "version": "1.0.0",
  "description": "DevPulse — Pro Developer Desktop Widget Suite with LeetCode Tracker, Focus Timer, and Screen Time",
  "author": "Sanjay <https://github.com/swethab01/widget>",
  "homepage": "https://github.com/swethab01/widget",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "npm run electron:dev",
    "build": "tsc -p tsconfig.node.json && vite build",
    "preview": "vite preview",
    "electron:dev": "cross-env NODE_ENV=development concurrently -k -p \"[{name}]\" -n \"VITE,ELECTRON\" -c \"yellow,cyan\" \"vite\" \"nodemon --watch dist-electron --exec electron .\"",
    "electron:build": "npm run build && electron-builder"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "electron-store": "^8.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "nodemon": "^3.1.4",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "~5.5.0",
    "vite": "^5.4.8",
    "vite-plugin-electron": "^0.28.7",
    "vite-plugin-electron-renderer": "^0.14.5"
  },
  "build": {
    "appId": "com.devpulse.app",
    "productName": "DevPulse",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "public/**/*"
    ],
    "extraResources": [
      {
        "from": "public/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "public/icon.png",
        "to": "icon.png"
      },
      {
        "from": "electron/bin/desktop-pin.exe",
        "to": "desktop-pin.exe"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico"
    }
  }
}
